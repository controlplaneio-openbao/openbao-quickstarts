dn: ou=Services,dc=example,dc=org
changetype: add
objectClass: organizationalUnit
ou: Services

dn: cn=openbao,ou=Services,dc=example,dc=org
changetype: add
objectClass: inetOrgPerson
cn: openbao
sn: openbao
mail: openbao@example.org
userPassword: password123

dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to dn.subtree="ou=Services,dc=example,dc=org" attrs=userPassword by dn.exact="cn=openbao,ou=Services,dc=example,dc=org" write by self write by anonymous auth by dn.exact="cn=admin,dc=example,dc=org" write by * none
olcAccess: {1}to dn.subtree="ou=Services,dc=example,dc=org" by dn.exact="cn=openbao,ou=Services,dc=example,dc=org" write by self write by dn.exact="cn=admin,dc=example,dc=org" write by * read
olcAccess: {2}to attrs=userPassword by self write by anonymous auth by dn.exact="cn=admin,dc=example,dc=org" write by * none
olcAccess: {3}to * by dn.exact="cn=openbao,ou=Services,dc=example,dc=org" read by self write by dn.exact="cn=admin,dc=example,dc=org" write by * read